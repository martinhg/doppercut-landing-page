---
import { countries } from '../i18n/config';
import { uiFor, chromeFor, countryPathFor } from '../i18n/regional';
import { htmlLangFor, resolveLocale, type CountryCode } from '../i18n/locale';
import { site } from '../config/site';

const locale = resolveLocale(Astro.props.country ?? Astro.params.country);
const t = uiFor(locale.code).nav;
const c = chromeFor(locale.code);

const { pathname } = Astro.url;
const pathWithoutCountry = pathname.replace(new RegExp(`^/${locale.code}(?=/|$)`), '');
const countryUrl = (code: string) => countryPathFor(locale.code, code, pathWithoutCountry);
const link = (path: string) => `/${locale.code}${path === '/' ? '' : path}`;

const navLinks = [
  { href: link('/#como-funciona'), label: t.how },
  { href: link('/precios'), label: t.pricing },
  { href: link('/contacto'), label: t.contact },
];
const isActive = (href: string) => !href.includes('#') && pathname.replace(/\/$/, '') === href;
---

<header class='fixed inset-x-0 top-0 z-50' id='navbar'>
  <div class='absolute inset-0 bg-white md:bg-white/90 md:backdrop-blur-md border-b border-slate-200/70 transition-shadow duration-200' id='nav-bg'></div>
  <nav class='relative max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4' aria-label={c.nav_label}>
    <a href={link('/')} class='shrink-0 flex items-center' aria-label={`${site.name}, ${t.home}`}>
      <img src={site.logo.light} alt={c.logo_alt} class='h-7 sm:h-9 w-auto' width='144' height='42' />
    </a>

    <ul class='hidden md:flex items-center gap-8'>
      {
        navLinks.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class='relative text-sm font-medium text-slate hover:text-navy aria-[current=page]:text-navy transition-colors after:absolute after:inset-x-0 after:-bottom-2 after:h-0.5 after:rounded-full after:bg-primary after:opacity-0 aria-[current=page]:after:opacity-100'>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class='flex items-center gap-1.5 sm:gap-4'>
      <details class='relative' data-dropdown>
        <summary class='list-none cursor-pointer flex items-center gap-1.5 px-1.5 sm:px-2.5 py-2 rounded-lg text-sm font-semibold text-navy hover:bg-slate-100 transition-colors' aria-label={`${c.country_label}: ${locale.country.name}`}>
          <span class='text-lg leading-none' aria-hidden='true'>{locale.country.flag}</span>
          <span class='hidden lg:inline'>{locale.code.toUpperCase()}</span>
          <svg class='hidden sm:block w-4 h-4 text-slate' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'></path></svg>
        </summary>
        <div class='absolute right-0 top-full pt-2 w-56 z-50'>
          <ul class='max-h-[70svh] overflow-y-auto overscroll-contain bg-white rounded-xl shadow-xl border border-slate-200 py-1'>
            <li class='px-4 py-2 text-xs font-semibold text-slate border-b border-slate-100'>{c.country_label}</li>
            {
              Object.values(countries).map((country) => (
                <li>
                  <a
                    href={countryUrl(country.code)}
                    hreflang={htmlLangFor(country.code as CountryCode)}
                    aria-current={country.code === locale.code ? 'true' : undefined}
                    class='flex items-center gap-3 px-4 py-2.5 text-sm text-ink hover:bg-slate-50 aria-[current=true]:bg-accent aria-[current=true]:text-primary-dark aria-[current=true]:font-semibold transition-colors'
                  >
                    <span class='text-lg leading-none' aria-hidden='true'>{country.flag}</span>
                    {country.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>

      <a href={site.appUrl} rel='noopener' class='hidden sm:block text-sm font-medium text-navy hover:text-primary-dark transition-colors'>{t.login}</a>

      <a href={link('/contacto')} class='press hidden sm:inline-flex px-5 py-2.5 bg-primary-dark text-white text-sm font-semibold rounded-full hover:bg-navy transition-colors'>
        <span class='lg:hidden'>{t.trial_short}</span>
        <span class='hidden lg:inline'>{t.trial}</span>
      </a>

      <a href={link('/contacto')} class='press sm:hidden inline-flex px-3.5 py-2 bg-primary-dark text-white text-xs font-semibold rounded-full whitespace-nowrap'>
        {t.trial_short}
      </a>

      <details class='md:hidden' data-dropdown>
        <summary class='list-none cursor-pointer p-2 -mr-2 rounded-lg text-navy hover:bg-slate-100' aria-label={c.menu_open}>
          <svg class='w-6 h-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'><path stroke-linecap='round' d='M4 7h16M4 12h16M4 17h16'></path></svg>
        </summary>
        <div class='absolute inset-x-0 top-full bg-white border-b border-slate-200 shadow-lg px-4 pt-2 pb-6'>
          <ul class='flex flex-col'>
            {
              navLinks.map((item) => (
                <li>
                  <a href={item.href} class='block py-3 text-base font-medium text-ink border-b border-slate-100'>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={site.appUrl} rel='noopener' class='block py-3 text-base font-medium text-ink'>{t.login}</a>
            </li>
          </ul>
          <a href={link('/contacto')} class='press mt-4 flex justify-center px-5 py-3.5 bg-primary-dark text-white font-semibold rounded-full'>{t.trial}</a>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const navBg = document.getElementById('nav-bg');
  const onScroll = () => navBg?.classList.toggle('shadow-sm', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Close any open dropdown on outside click, Escape, or after following an in-page link.
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>('[data-dropdown]');
  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) dropdowns.forEach((other) => other !== dropdown && (other.open = false));
    });
    dropdown.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (dropdown.open = false)));
  });
  document.addEventListener('click', (event) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    dropdowns.forEach((dropdown) => {
      if (!dropdown.open) return;
      dropdown.open = false;
      dropdown.querySelector('summary')?.focus();
    });
  });
</script>
