---
import type { StepDemo } from '../i18n/stepDemos';
import { moneyFormatter, sampleCashFor } from '../i18n/sampleMoney';

interface Props {
  copy: { f1_title: string; f1_desc: string; f2_title: string; f2_desc: string; f3_title: string; f3_desc: string };
  demo: StepDemo;
  /** BCP 47 tag used to format the sample amounts, e.g. es-AR. */
  locale: string;
  countryCode: string;
}

const { copy, demo, locale, countryCode } = Astro.props;
const f = demo.features;

const { currency, amount: cash } = sampleCashFor(countryCode);
const money = moneyFormatter(locale, currency);
const staff = [
  { initial: 'J', name: 'Juan', amount: money(Math.round(cash * 0.18)) },
  { initial: 'C', name: 'Caro', amount: money(Math.round(cash * 0.12)) },
];
const bars = [46, 62, 54, 71, 66, 90];

const cards = [
  { title: copy.f1_title, desc: copy.f1_desc, visual: 'agenda' },
  { title: copy.f2_title, desc: copy.f2_desc, visual: 'reminder' },
  { title: copy.f3_title, desc: copy.f3_desc, visual: 'cash' },
] as const;
---

<div class='grid gap-6 md:grid-cols-3'>
  {
    cards.map((card, i) => (
      <article class={`reveal ${i ? `delay-${i * 100}` : ''} group flex flex-col rounded-3xl border border-slate-200/80 bg-white p-3 shadow-sm transition-shadow duration-300 hover:shadow-xl hover:shadow-navy/5`}>
        <div class='relative h-52 overflow-hidden rounded-2xl bg-surface p-4' aria-hidden='true'>
          {card.visual === 'agenda' && (
            <div class='flex h-full flex-col transition-transform duration-300 ease-[var(--ease-out-brand)] group-hover:-translate-y-0.5'>
              <span class='inline-flex w-fit items-center gap-1.5 rounded-full bg-navy px-2.5 py-1 text-[11px] font-medium text-white'>
                <svg class='h-3 w-3 text-primary-light' viewBox='0 0 24 24' fill='currentColor'>
                  <path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z' />
                </svg>
                <span class='tabular'>03:12</span> · {f.whileAsleep}
              </span>
              <ul class='mt-3 flex flex-1 flex-col gap-2'>
                {f.slots.map((slot) => (
                  <li class='flex items-center gap-3 text-xs'>
                    <span class='tabular w-10 shrink-0 text-slate'>{slot.time}</span>
                    <span
                      class:list={[
                        'flex-1 truncate rounded-lg px-3 py-2',
                        slot.isNew && 'border border-primary/40 bg-accent font-semibold text-ink shadow-sm',
                        slot.booked && !slot.isNew && 'border border-slate-200 bg-white text-ink',
                        !slot.booked && 'border border-dashed border-slate-300 text-slate',
                      ]}
                    >
                      {slot.label}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {card.visual === 'reminder' && (
            <div class='-m-4 flex h-[calc(100%+2rem)] flex-col bg-[#efeae2] p-4'>
              <div class='flex items-center gap-2'>
                <span class='flex h-7 w-7 items-center justify-center rounded-full bg-white shadow-sm'>
                  <img src='/brand/favicon.svg' alt='' width='16' height='16' class='h-4 w-4' />
                </span>
                <span class='text-xs font-semibold text-ink'>TurnosPlus</span>
              </div>
              <div class='mt-3 max-w-[92%] rounded-2xl rounded-tl-sm bg-white px-3 py-2 text-xs leading-relaxed text-ink shadow-sm transition-transform duration-300 ease-[var(--ease-out-brand)] group-hover:-translate-y-0.5'>
                {f.reminder}
                <span class='mt-1 flex justify-end gap-1 text-[10px] text-slate'>
                  18:00 <span class='text-[#53bdeb]'>✓✓</span>
                </span>
              </div>
              <span class='mt-auto inline-flex w-fit items-center gap-1 rounded-full bg-success-surface px-2.5 py-1 text-[11px] font-semibold text-success'>
                <svg class='h-3 w-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'>
                  <path d='M5 13l4 4L19 7' />
                </svg>
                {f.reminderSent}
              </span>
            </div>
          )}

          {card.visual === 'cash' && (
            <div class='flex h-full flex-col rounded-xl bg-white p-3 shadow-sm transition-transform duration-300 ease-[var(--ease-out-brand)] group-hover:-translate-y-0.5'>
              <div class='flex items-start justify-between gap-2'>
                <div>
                  <p class='text-[11px] text-slate'>{f.cashToday}</p>
                  <p class='tabular text-xl font-bold text-ink'>{money(cash)}</p>
                </div>
                <span class='rounded-full bg-success-surface px-2 py-0.5 text-[10px] font-semibold text-success'>{f.trend}</span>
              </div>
              <div class='mt-2 flex h-12 items-end gap-1.5'>
                {bars.map((height, b) => (
                  <div class='flex flex-1 flex-col items-center gap-1'>
                    <div class={`w-full rounded-sm ${b === bars.length - 1 ? 'bg-primary' : 'bg-primary/25'}`} style={`height: ${height * 0.36}px`} />
                    <span class='text-[9px] leading-none text-slate'>{f.days[b]}</span>
                  </div>
                ))}
              </div>
              <div class='mt-auto border-t border-slate-100 pt-2'>
                <p class='mb-1 text-[10px] text-slate'>{f.commissions}</p>
                <div class='flex flex-col gap-1'>
                  {staff.map((person) => (
                    <div class='flex items-center justify-between text-[11px]'>
                      <span class='flex items-center gap-1.5 text-ink'>
                        <span class='flex h-4 w-4 items-center justify-center rounded-full bg-accent text-[9px] font-semibold text-primary-dark'>{person.initial}</span>
                        {person.name}
                      </span>
                      <span class='tabular font-medium text-ink'>{person.amount}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>

        <div class='px-4 pb-4 pt-5'>
          <h3 class='text-lg font-bold text-navy'>{card.title}</h3>
          <p class='mt-2 leading-relaxed text-slate'>{card.desc}</p>
        </div>
      </article>
    ))
  }
</div>
