---
import type { StepDemo } from '../../i18n/stepDemos';
import { moneyFormatter, sampleCashFor } from '../../i18n/sampleMoney';

interface Props {
  demo: StepDemo;
  locale: string;
  countryCode: string;
}

const { demo, locale, countryCode } = Astro.props;
const { currency, amount } = sampleCashFor(countryCode);
const money = moneyFormatter(locale, currency);

const hours = ['09', '10', '11', '12', '13'];
const span = hours.length - 1;
const services = demo.services.map((service) => service.name);
const names = demo.bookings.map((booking) => booking.name);
// [column, start (hours after 09:00), duration (hours), tone]
const blocks: [number, number, number, 'brand' | 'soft'][] = [
  [0, 0, 0.5, 'brand'],
  [0, 1, 1, 'soft'],
  [0, 2.5, 0.75, 'brand'],
  [1, 0.5, 0.75, 'soft'],
  [1, 1.5, 1, 'brand'],
  [1, 3, 0.5, 'soft'],
  [2, 0, 1, 'soft'],
  [2, 2, 0.5, 'brand'],
  [2, 3, 1, 'brand'],
];
const kpis = [
  [demo.app.bookingsToday, '14'],
  [demo.app.confirmed, '12'],
  [demo.features.cashToday, money(amount)],
];
---

<!-- Decorative preview of the management dashboard, built in markup so it always matches the brand. -->
<div class='flex h-[calc(100%-2rem)] text-[11px]' aria-hidden='true'>
  <aside class='hidden w-36 shrink-0 flex-col gap-1 border-r border-slate-100 bg-white p-3 sm:flex'>
    <img src='/brand/logo-primary.svg' alt='' width='96' height='28' class='mb-3 h-5 w-auto self-start' />
    {
      demo.app.nav.map((item, i) => (
        <span class:list={['rounded-md px-2 py-1.5', i === 0 ? 'bg-accent font-semibold text-primary-dark' : 'text-slate']}>{item}</span>
      ))
    }
  </aside>

  <div class='min-w-0 flex-1 overflow-hidden bg-surface p-3 sm:p-4'>
    <p class='text-sm font-bold text-ink'>{demo.today}</p>

    <div class='mt-2 grid grid-cols-3 gap-2'>
      {
        kpis.map(([label, value]) => (
          <div class='rounded-lg bg-white p-2 shadow-sm'>
            <p class='truncate text-[10px] text-slate'>{label}</p>
            <p class='tabular truncate text-xs font-bold text-ink sm:text-sm'>{value}</p>
          </div>
        ))
      }
    </div>

    <div class='mt-3 rounded-lg bg-white p-2 shadow-sm'>
      <div class='grid grid-cols-[2.25rem_1fr_1fr_1fr] gap-1.5 pb-1.5 text-[10px] font-semibold text-ink'>
        <span></span>
        {demo.app.team.map((member) => <span class='truncate'>{member}</span>)}
      </div>
      <div class='relative grid h-44 grid-cols-[2.25rem_1fr_1fr_1fr] gap-1.5'>
        <div class='relative'>
          {
            hours.map((hour, i) => (
              <span class='tabular absolute -translate-y-1/2 text-[9px] text-slate' style={`top: ${(i / span) * 100}%`}>
                {hour}:00
              </span>
            ))
          }
        </div>
        {
          demo.app.team.map((_, column) => (
            <div class='relative border-l border-slate-100'>
              {blocks
                .filter(([c]) => c === column)
                .map(([, start, duration, tone], k) => (
                  <div
                    class:list={[
                      'absolute inset-x-0.5 overflow-hidden rounded-md border-l-[3px] px-1.5 py-1 text-[9px] leading-tight',
                      tone === 'brand' ? 'border-primary bg-accent text-ink' : 'border-slate-300 bg-surface text-ink',
                    ]}
                    style={`top: ${(start / span) * 100}%; height: calc(${(duration / span) * 100}% - 3px)`}
                  >
                    <p class='truncate font-semibold'>{names[(column * 3 + k) % names.length]}</p>
                    <p class='truncate text-slate'>{services[(column + k) % services.length]}</p>
                  </div>
                ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
