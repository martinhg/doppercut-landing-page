---
import type { StepDemo } from '../../i18n/stepDemos';

interface Props {
  demo: StepDemo;
}

const { demo } = Astro.props;
const service = demo.services[0];
const dates = [17, 18, 19, 20, 21, 22];
const selectedDay = 3;
const times = ['10:00', '10:30', '11:00', '11:30', '12:00', '12:30'];
const selectedTime = 1;
---

<!-- Decorative preview of the client booking page, sized for the 220px phone frame. -->
<div class='relative flex h-full flex-col bg-white px-3.5 pt-9 text-ink' aria-hidden='true'>
  <div class='flex items-center gap-2'>
    <span class='flex h-7 w-7 items-center justify-center rounded-full bg-accent'>
      <img src='/brand/favicon.svg' alt='' width='16' height='16' class='h-4 w-4' />
    </span>
    <span class='text-[11px] font-semibold'>{demo.profile}</span>
  </div>
  <p class='mt-3 text-[15px] font-bold leading-tight'>{demo.app.bookTitle}</p>

  <div class='mt-3 flex items-center justify-between rounded-xl border border-primary/40 bg-accent px-3 py-2 text-[11px]'>
    <span class='font-semibold'>{service.name}</span>
    <span class='tabular text-primary-dark'>{service.duration}</span>
  </div>

  <p class='mt-3 text-[10px] font-semibold text-slate'>{demo.app.chooseDay}</p>
  <div class='mt-1.5 grid grid-cols-6 gap-1'>
    {
      dates.map((date, i) => (
        <span class:list={['flex flex-col items-center rounded-lg py-1', i === selectedDay ? 'bg-primary text-white' : 'bg-surface']}>
          <span class:list={['text-[8px]', i === selectedDay ? 'text-white/80' : 'text-slate']}>{demo.features.days[i]}</span>
          <span class='tabular text-[11px] font-semibold'>{date}</span>
        </span>
      ))
    }
  </div>

  <p class='mt-3 text-[10px] font-semibold text-slate'>{demo.app.available}</p>
  <div class='mt-1.5 grid grid-cols-3 gap-1.5'>
    {
      times.map((time, i) => (
        <span class:list={['tabular rounded-lg border py-1.5 text-center text-[10px]', i === selectedTime ? 'border-primary bg-primary font-semibold text-white' : 'border-slate-200 text-ink']}>
          {time}
        </span>
      ))
    }
  </div>

  <span class='absolute inset-x-3.5 bottom-5 rounded-xl bg-primary-dark py-2.5 text-center text-[11px] font-semibold text-white shadow-lg shadow-primary/30'>
    {demo.app.confirm}
  </span>
</div>
