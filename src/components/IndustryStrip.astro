---
import IndustryIcon from './IndustryIcon.astro';
import { industriesFor, industryIndexPath, industryPath, industryUiFor } from '../i18n/regional';

interface Props {
  country: string;
  /** Show the one-line pitch under each name (index page) instead of compact chips (home). */
  detailed?: boolean;
}

const { country, detailed = false } = Astro.props;
const industries = industriesFor(country);
const u = industryUiFor(country);
---

{
  industries.length > 0 &&
    (detailed ? (
      <ul class='grid gap-4 sm:grid-cols-2 lg:grid-cols-3'>
        {industries.map(({ id, copy }) => (
          <li>
            <a href={industryPath(country, id)} class='group flex h-full gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-primary transition-colors'>
              <span class='flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent text-primary-dark'>
                <IndustryIcon id={id} class='h-5 w-5' />
              </span>
              <span>
                <span class='block font-bold text-navy group-hover:text-primary-dark transition-colors'>{copy.name}</span>
                <span class='mt-1 block text-sm text-slate leading-relaxed'>{copy.card}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class='text-center'>
        <p class='text-sm font-semibold uppercase tracking-wider text-slate'>{u.stripTitle}</p>
        <!-- Phones: one swipeable row so the strip stays short under the hero. sm+: wrapped and centered. -->
        <ul class='mt-6 -mx-6 flex gap-2 overflow-x-auto px-6 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:flex-wrap sm:justify-center sm:gap-3 sm:overflow-visible sm:px-0 sm:pb-0'>
          {industries.map(({ id, copy }) => (
            <li class='shrink-0'>
              <a href={industryPath(country, id)} class='inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-ink shadow-sm hover:border-primary hover:text-primary-dark transition-colors'>
                <IndustryIcon id={id} class='h-4 w-4 text-primary-dark' />
                {copy.name}
              </a>
            </li>
          ))}
        </ul>
        <a href={industryIndexPath(country)} class='mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-dark hover:text-navy transition-colors'>
          {u.stripAll}
          <svg class='h-4 w-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 12h14M13 6l6 6-6 6' />
          </svg>
        </a>
      </div>
    ))
}
