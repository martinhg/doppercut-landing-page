---
import { chrome } from '../i18n/chrome';
import type { Lang } from '../i18n/locale';

interface Props {
  lang: Lang;
  country: string;
}

const { lang, country } = Astro.props;
const c = chrome[lang];
---

<!--
  Informational notice: the site only sets essential storage and uses cookieless
  Vercel Web Analytics, so no consent gate is required. The choice is remembered locally.
-->
<div
  id='cookie-notice'
  role='region'
  aria-label={c.cookies}
  hidden
  class='fixed left-4 right-4 sm:left-6 sm:right-auto sm:max-w-sm z-40 rounded-2xl border border-slate-200 bg-white p-4 shadow-xl shadow-black/10 text-sm text-slate'
  style='bottom: max(5.5rem, calc(env(safe-area-inset-bottom) + 4.5rem));'
>
  <p class='text-ink'>{c.cookie_text}</p>
  <div class='mt-3 flex items-center justify-between gap-4'>
    <a href={`/${country}/cookies`} class='font-medium text-primary-dark underline'>{c.cookie_link}</a>
    <button type='button' class='press rounded-full bg-navy px-4 py-2 font-semibold text-white' data-cookie-dismiss>{c.cookie_ok}</button>
  </div>
</div>

<script>
  const KEY = 'tp-cookie-notice';
  const notice = document.getElementById('cookie-notice');
  let dismissed = false;
  try {
    dismissed = localStorage.getItem(KEY) === '1';
  } catch {
    // Storage blocked (private mode): show the notice, it simply will not be remembered.
  }
  if (notice && !dismissed) {
    notice.hidden = false;
    notice.querySelector('[data-cookie-dismiss]')?.addEventListener('click', () => {
      notice.hidden = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* ignore */
      }
    });
  }
</script>
