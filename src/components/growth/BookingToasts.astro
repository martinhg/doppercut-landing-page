---
import type { StepDemo } from '../../i18n/stepDemos';

interface Props {
  demo: StepDemo;
}

const { demo } = Astro.props;
const toasts = demo.bookings.slice(0, 3).map((booking, i) => ({
  ...booking,
  service: demo.services[i % demo.services.length].name,
}));
---

<!--
  Notifications that pop over the dashboard screenshot. Positioned by the parent wrapper;
  stepScenes.ts cycles them. Without JS only the first one shows.
-->
<div data-scene='growth-toasts' class='grid' aria-hidden='true'>
  {
    toasts.map((toast, i) => (
      <div data-s={`toast-${i}`} class='flex w-60 items-center gap-3 rounded-2xl border border-slate-100 bg-white/95 p-3 shadow-xl shadow-navy/10 backdrop-blur [grid-area:1/1]' style={i ? 'opacity: 0' : undefined}>
        <span class='flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent'>
          <img src='/brand/favicon.svg' alt='' width='18' height='18' class='h-[18px] w-[18px]' />
        </span>
        <span class='min-w-0 text-xs leading-snug'>
          <span class='block font-semibold text-ink'>{demo.newBooking}</span>
          <span class='block truncate text-slate'>
            {toast.name} · {toast.service} · {toast.when}
          </span>
        </span>
      </div>
    ))
  }
</div>

<script>
  import { initStepScenes } from '../../scripts/stepScenes';
  initStepScenes();
</script>
