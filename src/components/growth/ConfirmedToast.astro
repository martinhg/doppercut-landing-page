---
import type { StepDemo } from '../../i18n/stepDemos';

interface Props {
  demo: StepDemo;
}

const { demo } = Astro.props;
const booking = demo.bookings[0];
---

<!-- "Booking confirmed" bubble that pops next to the phone screenshot. Static and visible without JS. -->
<div data-scene='growth-confirmed' aria-hidden='true'>
  <div data-s='bubble' class='flex items-center gap-2.5 rounded-2xl bg-white p-2.5 pr-4 shadow-2xl shadow-black/30'>
    <span class='flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-success text-white'>
      <svg class='h-4 w-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'>
        <path data-s='check' d='M5 13l4 4L19 7' pathLength='1' stroke-dasharray='1 1' stroke-dashoffset='0'></path>
      </svg>
    </span>
    <span class='text-xs leading-snug'>
      <span class='block font-semibold text-ink'>{demo.confirmed}</span>
      <span class='block text-slate'>{booking.name} · {booking.when}</span>
    </span>
  </div>
</div>

<script>
  import { initStepScenes } from '../../scripts/stepScenes';
  initStepScenes();
</script>
