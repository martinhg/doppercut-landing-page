---
import { ui } from '../i18n/content';
import { countryTerms } from '../i18n/config';
import { chrome } from '../i18n/chrome';
import { resolveLocale } from '../i18n/locale';
import { site, whatsappLink } from '../config/site';

const locale = resolveLocale(Astro.props.country ?? Astro.params.country);
const t = ui[locale.lang];
const c = chrome[locale.lang];
const link = (path: string) => `/${locale.code}${path}`;
const currentYear = new Date().getFullYear();
const legalIdentity = [site.legal.taxId && `CUIT ${site.legal.taxId}`, site.legal.address].filter(Boolean).join(' · ');

const productLinks = [
  { href: link('/#como-funciona'), label: t.nav.how },
  { href: link('/precios'), label: t.nav.pricing },
  { href: link('/contacto'), label: t.nav.trial },
];
const legalLinks = [
  { href: link('/privacidad'), label: t.footer.privacy },
  { href: link('/terminos'), label: t.footer.terms },
  { href: link('/aviso-legal'), label: c.legal_notice },
  { href: link('/cookies'), label: c.cookies },
];
---

<footer class='bg-navy text-slate-300 pt-16 pb-28 sm:pb-10'>
  <div class='max-w-6xl mx-auto px-6'>
    <div class='grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-4 mb-14'>
      <div class='col-span-2'>
        <a href={link('')} class='inline-flex mb-5' aria-label={site.name}>
          <img src={site.logo.dark} alt={c.logo_alt} class='h-9 w-auto' width='144' height='42' loading='lazy' />
        </a>
        <p class='text-slate-300 text-sm leading-relaxed max-w-xs mb-6'>{t.footer.description.replace(/{appointment}/g, countryTerms[locale.code].appointment.toLowerCase())}</p>

        <ul class='space-y-2 text-sm'>
          <li><a href={`mailto:${site.email}`} class='hover:text-primary-light transition-colors'>{site.email}</a></li>
          <li><a href={whatsappLink(c.whatsapp_message)} target='_blank' rel='noopener noreferrer' class='hover:text-primary-light transition-colors'>WhatsApp {site.whatsappDisplay}</a></li>
          <li><a href={site.instagram} target='_blank' rel='noopener noreferrer' class='hover:text-primary-light transition-colors'>Instagram {site.instagramHandle}</a></li>
        </ul>
      </div>

      <nav aria-labelledby='footer-product'>
        <h2 id='footer-product' class='text-white font-semibold mb-5 text-sm'>{t.footer.product}</h2>
        <ul class='space-y-3 text-sm'>
          {
            productLinks.map((item) => (
              <li>
                <a href={item.href} class='hover:text-primary-light transition-colors'>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby='footer-legal'>
        <h2 id='footer-legal' class='text-white font-semibold mb-5 text-sm'>Legal</h2>
        <ul class='space-y-3 text-sm'>
          {
            legalLinks.map((item) => (
              <li>
                <a href={item.href} class='hover:text-primary-light transition-colors'>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class='border-t border-white/10 pt-8 flex flex-col md:flex-row md:items-center gap-2 md:gap-6 text-xs text-slate-400'>
      <p>&copy; {currentYear} {site.name}. {t.footer.all_rights_reserved}</p>
      {legalIdentity && <p>{legalIdentity}</p>}
    </div>
  </div>
</footer>
