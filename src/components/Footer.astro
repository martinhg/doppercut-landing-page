---
import { uiFor, chromeFor, industriesFor, industryIndexPath, industryPath, industryUiFor } from '../i18n/regional';
import { footerIndustries } from '../i18n/industries/index';
import { countryTerms } from '../i18n/config';
import { resolveLocale } from '../i18n/locale';
import { site, whatsappLink } from '../config/site';

const locale = resolveLocale(Astro.props.country ?? Astro.params.country);
const t = uiFor(locale.code);
const c = chromeFor(locale.code);
const link = (path: string) => `/${locale.code}${path}`;
const currentYear = new Date().getFullYear();
const legalIdentity = [site.legal.taxId && `CUIT ${site.legal.taxId}`, site.legal.address].filter(Boolean).join(' · ');

const productLinks = [
  { href: link('/#como-funciona'), label: t.nav.how },
  { href: link('/precios'), label: t.nav.pricing },
  { href: link('/contacto'), label: t.nav.trial },
];
const industryUi = industryUiFor(locale.code);
const availableIndustries = industriesFor(locale.code);
const industryLinks = availableIndustries
  .filter(({ id }) => footerIndustries.includes(id))
  .map(({ id, copy }) => ({ href: industryPath(locale.code, id), label: copy.name }));
const legalLinks = [
  { href: link('/privacidad'), label: t.footer.privacy },
  { href: link('/terminos'), label: t.footer.terms },
  { href: link('/aviso-legal'), label: c.legal_notice },
  { href: link('/cookies'), label: c.cookies },
];
---

<footer class='bg-navy text-slate-300 pt-16 pb-28 sm:pb-10'>
  <div class='max-w-6xl mx-auto px-6'>
    <div class='grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-5 mb-14'>
      <div class='col-span-2'>
        <a href={link('')} class='inline-flex mb-5' aria-label={site.name}>
          <img src={site.logo.dark} alt={c.logo_alt} class='h-9 w-auto' width='144' height='42' loading='lazy' />
        </a>
        <p class='text-slate-300 text-sm leading-relaxed max-w-xs mb-6'>{t.footer.description.replace(/{appointment}/g, countryTerms[locale.code].appointment.toLowerCase())}</p>

        <!-- Icons name the channel; aria-labels keep that name for screen readers. -->
        <ul class='space-y-3 text-sm'>
          <li>
            <a href={`mailto:${site.email}`} class='inline-flex items-center gap-2.5 hover:text-primary-light transition-colors'>
              <svg class='w-4 h-4 shrink-0' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'>
                <path stroke-linecap='round' stroke-linejoin='round' d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'></path>
              </svg>
              {site.email}
            </a>
          </li>
          <li>
            <a href={whatsappLink(c.whatsapp_message)} target='_blank' rel='noopener noreferrer' aria-label={`WhatsApp ${site.whatsappDisplay}`} class='inline-flex items-center gap-2.5 hover:text-primary-light transition-colors'>
              <svg class='w-4 h-4 shrink-0' fill='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
                <path d='M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z'></path>
              </svg>
              {site.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={site.instagram} target='_blank' rel='noopener noreferrer' aria-label={`Instagram ${site.instagramHandle}`} class='inline-flex items-center gap-2.5 hover:text-primary-light transition-colors'>
              <svg class='w-4 h-4 shrink-0' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' aria-hidden='true'>
                <rect x='3' y='3' width='18' height='18' rx='5'></rect>
                <circle cx='12' cy='12' r='4'></circle>
                <circle cx='17.5' cy='6.5' r='0.5' fill='currentColor'></circle>
              </svg>
              {site.instagramHandle}
            </a>
          </li>
        </ul>
      </div>

      <nav aria-labelledby='footer-product'>
        <h2 id='footer-product' class='text-white font-semibold mb-5 text-sm'>{t.footer.product}</h2>
        <ul class='space-y-3 text-sm'>
          {
            productLinks.map((item) => (
              <li>
                <a href={item.href} class='hover:text-primary-light transition-colors'>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        industryLinks.length > 0 && (
          <nav aria-labelledby='footer-industries'>
            <h2 id='footer-industries' class='text-white font-semibold mb-5 text-sm'>{industryUi.footerTitle}</h2>
            <ul class='space-y-3 text-sm'>
              {industryLinks.map((item) => (
                <li>
                  <a href={item.href} class='hover:text-primary-light transition-colors'>
                    {item.label}
                  </a>
                </li>
              ))}
              <li>
                <a href={industryIndexPath(locale.code)} class='font-semibold text-primary-light hover:text-white transition-colors'>
                  {industryUi.stripAll}
                </a>
              </li>
            </ul>
          </nav>
        )
      }

      <nav aria-labelledby='footer-legal'>
        <h2 id='footer-legal' class='text-white font-semibold mb-5 text-sm'>Legal</h2>
        <ul class='space-y-3 text-sm'>
          {
            legalLinks.map((item) => (
              <li>
                <a href={item.href} class='hover:text-primary-light transition-colors'>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class='border-t border-white/10 pt-8 flex flex-col md:flex-row md:items-center gap-2 md:gap-6 text-xs text-slate-400'>
      <p>&copy; {currentYear} {site.name}. {t.footer.all_rights_reserved}</p>
      {legalIdentity && <p>{legalIdentity}</p>}
    </div>
  </div>
</footer>
