---
import type { StepDemo } from '../../i18n/stepDemos';

interface Props {
  demo: StepDemo;
}

const { demo } = Astro.props;
---

<!--
  Step 1: a messy WhatsApp price list becomes a configured profile.
  Markup is the final frame; stepScenes.ts animates it in a loop while visible.
-->
<div data-scene='configure' class='relative flex h-full w-full items-center justify-center gap-2 px-4 sm:gap-4 sm:px-6'>
  <div data-s='bubble' class='w-[47%] max-w-[200px] rounded-2xl rounded-tl-sm bg-[#e7fbe0] p-3 text-[10px] leading-snug text-ink shadow-sm sm:text-[11px]'>
    <p class='mb-1.5 font-semibold'>{demo.greeting}</p>
    {
      demo.services.map((service, i) => (
        <p data-s={`line-${i}`} class='-mx-1 rounded px-1'>
          • {service.name} · {service.duration}
        </p>
      ))
    }
    <p data-s='line-3' class='-mx-1 mt-1 rounded px-1 text-slate'>{demo.hours}</p>
    <p class='mt-1 text-right text-[9px] text-slate'>{demo.sentAt} ✓✓</p>
  </div>

  <svg data-s='arrow' class='h-4 w-4 shrink-0 text-primary' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
    <path d='M5 12h14M13 6l6 6-6 6'></path>
  </svg>

  <div class='w-[47%] max-w-[200px] rounded-2xl border border-slate-200 bg-white p-3 shadow-lg shadow-navy/5'>
    <div class='mb-2 flex items-center gap-2'>
      <img src='/brand/favicon.svg' alt='' width='20' height='20' class='h-5 w-5' />
      <span class='text-[11px] font-semibold text-ink'>{demo.profile}</span>
    </div>
    {
      demo.services.map((service, i) => (
        <div data-s={`row-${i}`} class='mb-1 flex items-center justify-between gap-2 rounded-lg bg-surface px-2 py-1 text-[10px] sm:text-[11px]'>
          <span class='truncate text-ink'>{service.name}</span>
          <span class='tabular shrink-0 font-medium text-primary-dark'>{service.duration}</span>
        </div>
      ))
    }
    <div data-s='row-3' class='flex items-center gap-1 px-2 py-1 text-[10px] text-slate'>
      <svg class='h-3 w-3 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='9'></circle><path d='M12 7v5l3 2'></path></svg>
      <span>{demo.hours}</span>
    </div>
    <div data-s='badge' class='mt-1.5 inline-flex items-center gap-1 rounded-full bg-success-surface px-2 py-0.5 text-[10px] font-semibold text-success'>
      <svg class='h-3 w-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M5 13l4 4L19 7'></path></svg>
      {demo.ready}
    </div>
  </div>
</div>

<script>
  import { initStepScenes } from '../../scripts/stepScenes';
  initStepScenes();
</script>
