---
import { industryIcons, type IndustryId } from '../i18n/industries/index';

interface Props {
  id: IndustryId;
  class?: string;
}

const { id, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' set:html={industryIcons[id]} />
