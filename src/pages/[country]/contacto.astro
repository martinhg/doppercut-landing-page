---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site, whatsappLink } from '../../config/site';
import { uiFor, chromeFor } from '../../i18n/regional';

// i18n
import { countries, countryTerms } from '../../i18n/config';
import { ui } from '../../i18n/content';

export function getStaticPaths() {
  return Object.keys(countries).map((code) => ({ params: { country: code } }));
}

const countryParam = typeof Astro.params?.country === 'string' ? Astro.params.country : 'ar';
const currentCountry = countries[countryParam as keyof typeof countries] ?? countries.ar;
const lang = (currentCountry.lang ?? 'es_latam') as keyof typeof ui;
const t = uiFor(countryParam);
const terms = countryTerms[countryParam as keyof typeof countryTerms];

const tr = (text: string) => text.replace(/{appointment}/g, terms.appointment);

const c = chromeFor(countryParam);
const titleSEO = `${t.contact.title} | ${site.name} ${currentCountry.name}`;
---

<Layout title={titleSEO} description={`${t.contact.subtitle} ${t.contact.first_days}`.slice(0, 158)}>
  <Navbar country={countryParam} />
  <main id='main' class='pt-28 sm:pt-32 pb-24 bg-surface relative overflow-hidden'>
    <!-- Fondo sutil -->
    <div class='absolute top-0 right-0 w-[800px] h-[800px] bg-accent/60 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none'></div>

    <div class='max-w-6xl mx-auto px-6 relative z-10'>
      <!-- Phones: intro, form, then reasons. Desktop: intro and reasons on the left, form on the right. -->
      <div class='grid lg:grid-cols-2 gap-x-12 gap-y-10 lg:items-start'>
        <div class='lg:col-start-1'>
          <h1 class='text-4xl md:text-5xl font-bold text-navy mb-6'>{t.contact.title}</h1>
          <p class='text-lg text-slate leading-relaxed'>
            {t.contact.subtitle}
            <br /><strong>{t.contact.remember}:</strong>{' '}
            {t.contact.first_days}
          </p>
        </div>

        <div class='lg:col-start-2 lg:row-span-2 lg:row-start-1 bg-white p-6 sm:p-8 rounded-3xl shadow-xl shadow-navy/5 border border-slate-200 relative'>
          <!-- Badge de oferta en el form -->
          <div class='absolute -top-4 left-1/2 -translate-x-1/2 bg-navy text-white px-4 py-1 rounded-full text-sm font-bold shadow-lg whitespace-nowrap'>{t.contact.form_title}</div>

          <div class='mt-4'><LeadForm lang={lang} country={countryParam} source='contact' /></div>
        </div>

        <div class='lg:col-start-1'>
          <div class='space-y-6'>
            <!-- Feature 1 -->
            <div class='flex gap-4'>
              <div class='w-12 h-12 rounded-xl bg-white shadow-md flex items-center justify-center text-primary-dark shrink-0'>
                <svg class='w-6 h-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>
              </div>
              <div>
                <h2 class='font-bold text-navy'>{t.contact.f1_title}</h2>
                <p class='text-slate text-sm'>{t.contact.f1_desc}</p>
              </div>
            </div>

            <!-- Feature 2 -->
            <div class='flex gap-4'>
              <div class='w-12 h-12 rounded-xl bg-white shadow-md flex items-center justify-center text-primary-dark shrink-0'>
                <svg class='w-6 h-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>
              </div>
              <div>
                <h2 class='font-bold text-navy'>{t.contact.f2_title}</h2>
                <p class='text-slate text-sm'>{t.contact.f2_desc}</p>
              </div>
            </div>
          </div>

          <!-- Contacto Directo WhatsApp -->
          <div class='mt-8 p-6 bg-white rounded-2xl border border-slate-200 shadow-sm'>
            <p class='text-sm text-slate mb-2'>{t.contact.ws_text}</p>
            <a href={whatsappLink(c.whatsapp_message)} target='_blank' rel='noopener noreferrer' class='inline-flex items-center gap-2 text-success font-bold hover:text-navy transition-colors text-lg'>
              <svg class='w-6 h-6' fill='currentColor' viewBox='0 0 24 24' aria-hidden='true'
                ><path
                  d='M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z'
                ></path></svg
              >
              {t.contact.ws_cta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer country={countryParam} />
</Layout>
