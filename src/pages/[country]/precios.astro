---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../config/site';
import PricingMath from '../../components/PricingMath.astro';
import { htmlLangFor, type CountryCode } from '../../i18n/locale';
import { chrome } from '../../i18n/chrome';

// i18n
import { countries, countryTerms } from '../../i18n/config';
import { ui } from '../../i18n/content';

export function getStaticPaths() {
  return Object.keys(countries).map((code) => ({ params: { country: code } }));
}

const countryParam = typeof Astro.params?.country === 'string' ? Astro.params.country : 'ar';
const currentCountry = countries[countryParam as keyof typeof countries] ?? countries.ar;
const lang = (currentCountry.lang ?? 'es_ar') as keyof typeof ui;
const t = ui[lang];
const terms = countryTerms[countryParam as keyof typeof countryTerms];

const tr = (text: string) => text.replace(/{appointment}/g, terms.appointment);

const titleSEO = `${t.nav.pricing}: ${chrome[lang].seo_short} | ${site.name} ${currentCountry.name}`;
const withSymbol = (price: string) => (/^[\d.,]+$/.test(price) ? `$${price}` : price);
const p = t.pricing;
const faqs = [
  [p.faq1_title, p.faq1_desc],
  [p.faq3_title, p.faq3_desc],
  [p.faq4_title, p.faq4_desc],
  [p.faq5_title, p.faq5_desc],
  [p.faq2_title, p.faq2_desc],
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};

const roadmapFeatures = [
  {
    title: t.pricing.card1_title,
    desc: t.pricing.card1_desc,
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
  },
  {
    title: t.pricing.card2_title,
    desc: t.pricing.card2_desc,
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
  },
];
---

<Layout title={titleSEO} description={t.pricing.desc} schema={[faqSchema]}>
  <Navbar country={countryParam} />

  <main id='main' class='pt-28 sm:pt-32 pb-24 bg-surface min-h-svh'>
    <!-- HERO -->
    <div class='max-w-4xl mx-auto px-6 text-center mb-12'>
      <h1 class='text-4xl md:text-5xl font-bold text-navy mb-6 tracking-tight'>
        {t.pricing.title1}<br />
        <span class='text-primary-dark'>{t.pricing.title2}</span>
      </h1>
      <p class='text-lg text-slate max-w-2xl mx-auto'>{t.pricing.desc}</p>
    </div>

    <div class='max-w-5xl mx-auto px-6 mb-12'>
      <div class='bg-primary-gradient rounded-2xl p-1 shadow-[0_10px_30px_-10px_rgb(0_168_232/0.5)]'>
        <div class='rounded-xl p-6 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6'>
          <div class='flex flex-col sm:flex-row items-start gap-3 sm:gap-4'>
            <div class='bg-white text-primary-dark font-bold px-3 py-1 rounded-full text-xs sm:mt-1 shrink-0'>{t.pricing.launch_offer}</div>
            <div>
              <h2 class='text-xl font-bold text-white'>{t.pricing.founder_offer}</h2>
              <p class='text-white/90 text-sm mt-1'>
                {t.pricing.founder_desc} <span class='font-bold text-white underline decoration-white/60'>25% OFF</span> {t.pricing.offer_months}
              </p>
            </div>
          </div>
          <div class='md:text-right tabular'>
            <div class='text-sm text-white/80 line-through'>{withSymbol(currentCountry.price_regular)}</div>
            <div class='text-3xl font-bold text-white'>{withSymbol(currentCountry.price_promo)}<span class='text-sm font-normal'>/{t.pricing.month}</span></div>
            <div class='text-xs text-white/80'>{t.pricing.biannual}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- PRICING CARD PRINCIPAL -->
    <div class='max-w-5xl mx-auto px-6 mb-24'>
      <div class='bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden flex flex-col lg:flex-row relative'>
        <!-- Etiqueta de Garantía -->
        <div class='absolute top-0 right-0 bg-primary-dark text-white text-xs font-bold px-4 py-2 rounded-bl-xl z-20'>{t.pricing.guarantee}</div>

        <!-- Left Side: Price Anchor -->
        <div class='lg:w-1/2 p-8 md:p-12 flex flex-col justify-center border-b lg:border-b-0 lg:border-r border-slate-100 bg-slate-50/50'>
          <div class='text-center lg:text-left'>
            <h2 class='text-xl font-semibold text-navy mb-2'>{t.pricing.card_title}</h2>
            <p class='text-slate text-sm mb-6'>{t.pricing.card_anchor}</p>

            <div class='flex items-baseline justify-center lg:justify-start gap-2 mb-2'>
              <span class='tabular text-5xl sm:text-6xl font-bold text-navy tracking-tight'>{withSymbol(currentCountry.price_regular)}</span>
              <span class='text-lg text-slate font-medium'>{currentCountry.currency}/{t.pricing.month}</span>
            </div>

            <p class='text-slate text-sm mb-8'>{t.pricing.card_desc}</p>

            <!-- CTA Principal -->
            <a href={`/${countryParam}/contacto`} class='press inline-flex justify-center items-center w-full px-8 py-4 bg-primary-dark text-white text-lg font-semibold rounded-xl hover:bg-navy transition-colors group'>
              {t.pricing.cta}
              <svg class='w-5 h-5 ml-2' fill='none' viewBox='0 0 24 24' stroke='currentColor' aria-hidden='true'
                ><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M14 5l7 7m0 0l-7 7m7-7H3'></path></svg
              >
            </a>
            <div class='mt-4 flex items-center justify-center lg:justify-start gap-2 text-xs text-slate'>
              <svg aria-hidden='true' class='w-4 h-4 text-success' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>
              {t.pricing.card_cancel}
            </div>
          </div>
        </div>

        <!-- Right Side: Value Stack -->
        <div class='lg:w-1/2 p-8 md:p-12 bg-white'>
          <h3 class='text-lg font-bold text-navy mb-6'>{t.pricing.card_include}</h3>
          <ul class='space-y-4'>
            {
              t.pricing.features.map((item) => (
                <li class='flex items-start gap-3'>
                  <div class='bg-accent p-1 rounded-full mt-0.5 shrink-0'>
                    <svg aria-hidden='true' class='w-4 h-4 text-primary-dark' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M5 13l4 4L19 7' />
                    </svg>
                  </div>
                  <span class='text-ink text-sm font-medium leading-relaxed'>{tr(item)}</span>
                </li>
              ))
            }
          </ul>

          <!-- Multi-sucursal Upsell -->
          <div class='mt-8 pt-6 border-t border-slate-100 bg-accent/60 -mx-8 md:-mx-12 -mb-8 md:-mb-12 p-8'>
            <p class='font-bold text-navy text-sm mb-1'>{t.pricing.business}</p>
            <p class='text-slate text-xs'>{t.pricing.business_desc}</p>
          </div>
        </div>
      </div>
    </div>

    <div class='max-w-3xl mx-auto px-6 -mt-12 mb-24'>
      <PricingMath
        copy={t.section_7}
        planName={p.card_title}
        monthLabel={p.month}
        priceRegular={currentCountry.price_regular}
        pricePromo={currentCountry.price_promo}
        currency={currentCountry.currency}
        countryCode={countryParam}
        locale={htmlLangFor(countryParam as CountryCode)}
        pricingHref={`/${countryParam}/precios`}
        mathOnly
      />
    </div>

    <!-- THE "WHY US" SECTION (Roadmap & Service) -->
    <div class='max-w-5xl mx-auto px-6 mb-20'>
      <div class='grid md:grid-cols-2 gap-8'>
        {
          roadmapFeatures.map((feature) => (
            <div class='bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex gap-6 items-start'>
              <div class='p-4 bg-accent text-primary-dark rounded-xl shrink-0' set:html={feature.icon} />
              <div>
                <h3 class='text-xl font-bold text-navy mb-2'>{feature.title}</h3>
                <p class='text-slate'>{feature.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- STEP BY STEP (Reducing Friction) -->
    <div class='max-w-4xl mx-auto px-6 text-center'>
      <h2 class='text-2xl font-bold text-navy mb-12'>{t.pricing.f_title}</h2>
      <div class='relative flex flex-col md:flex-row justify-between items-center gap-8 z-10'>
        <!-- Line connector for desktop -->
        <div class='hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-slate-200 -z-10 -translate-y-1/2'></div>

        <!-- Step 1 -->
        <div class='bg-white p-6 rounded-xl border border-slate-200 shadow-sm w-full md:w-64'>
          <div class='w-10 h-10 bg-navy text-white rounded-full flex items-center justify-center font-bold mx-auto mb-4 text-lg'>1</div>
          <h3 class='font-bold text-navy mb-2'>{t.pricing.f1_title}</h3>
          <p class='text-sm text-slate'>{t.pricing.f1_desc}</p>
        </div>

        <!-- Step 2 -->
        <div class='bg-white p-6 rounded-xl border border-slate-200 shadow-sm w-full md:w-64'>
          <div class='w-10 h-10 bg-navy text-white rounded-full flex items-center justify-center font-bold mx-auto mb-4 text-lg'>2</div>
          <h3 class='font-bold text-navy mb-2'>{t.pricing.f2_title}</h3>
          <p class='text-sm text-slate'>{t.pricing.f2_desc}</p>
        </div>

        <!-- Step 3 -->
        <div class='bg-white p-6 rounded-xl border border-primary ring-2 ring-primary/20 shadow-md w-full md:w-64'>
          <div class='w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold mx-auto mb-4 text-lg'>3</div>
          <h3 class='font-bold text-navy mb-2'>{t.pricing.f3_title}</h3>
          <p class='text-sm text-slate'>{t.pricing.f3_desc}</p>
        </div>
      </div>

      <div class='mt-12'>
        <a href={`/${countryParam}/contacto`} class='text-primary-dark font-semibold underline hover:text-navy transition-colors'> {t.pricing.ask} &rarr; </a>
      </div>
    </div>

    <!-- FAQ / OBJECTIONS -->
    <div class='max-w-3xl mx-auto px-6 mt-10'>
      <h2 class='text-2xl font-bold text-navy mb-8 text-center'>{t.pricing.faq_title}</h2>
      <div class='grid gap-4'>
        {
          faqs.map(([question, answer]) => (
            <div class='bg-white p-6 rounded-xl border border-slate-100 shadow-sm'>
              <h3 class='font-bold text-navy'>{question}</h3>
              <p class='text-slate text-sm mt-2'>{answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <Footer country={countryParam} />
</Layout>
