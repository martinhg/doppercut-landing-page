---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import IndustryIcon from '../../../components/IndustryIcon.astro';
import { countries } from '../../../i18n/config';
import { site, whatsappLink } from '../../../config/site';
import { chromeFor, industriesFor, industryIndexPath, industryPath, industrySectionFor, industryUiFor } from '../../../i18n/regional';

export function getStaticPaths() {
  return Object.keys(countries).flatMap((code) =>
    industriesFor(code).map(({ slug }) => ({ params: { country: code, section: industrySectionFor(code), industry: slug } })),
  );
}

const country = String(Astro.params.country);
const industries = industriesFor(country);
const current = industries.find(({ slug }) => slug === Astro.params.industry)!;
const { copy } = current;
const u = industryUiFor(country);
const c = chromeFor(country);
const contactHref = `/${country}/contacto`;
const others = industries.filter(({ id }) => id !== current.id);

// Sample agenda: services laid out back to back from 9:00, so the visual reads as a real day.
let minutes = 9 * 60;
const agenda = copy.services.map((service) => {
  const time = `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
  minutes += Number.parseInt(service.duration, 10) || 30;
  return { ...service, time };
});

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: copy.faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: new URL(`/${country}`, site.url).href },
      { '@type': 'ListItem', position: 2, name: u.breadcrumb, item: new URL(industryIndexPath(country), site.url).href },
      { '@type': 'ListItem', position: 3, name: copy.name },
    ],
  },
];
---

<Layout title={`${copy.seoTitle} | ${site.name}`} description={copy.seoDescription} schema={schema}>
  <Navbar country={country} />

  <main id='main' class='bg-surface'>
    <!-- Hero: promise on the left, a sample day of this industry on the right. -->
    <section class='pt-28 sm:pt-36 pb-16 sm:pb-24'>
      <div class='max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center'>
        <div>
          <nav aria-label={u.breadcrumb} class='mb-6 text-sm text-slate'>
            <a href={industryIndexPath(country)} class='hover:text-navy transition-colors'>{u.breadcrumb}</a>
            <span aria-hidden='true' class='mx-1.5'>/</span>
            <span class='text-navy font-medium'>{copy.name}</span>
          </nav>
          <h1 class='text-4xl md:text-5xl font-bold text-navy tracking-tight text-balance'>{copy.heroTitle}</h1>
          <p class='mt-6 text-lg text-slate leading-relaxed max-w-xl'>{copy.heroSubtitle}</p>
          <div class='mt-8 flex flex-col sm:flex-row gap-3'>
            <a href={contactHref} class='press inline-flex justify-center px-7 py-4 bg-primary-dark text-white font-semibold rounded-full hover:bg-navy transition-colors'>{u.ctaButton}</a>
            <a href={whatsappLink(c.whatsapp_message)} target='_blank' rel='noopener noreferrer' class='press inline-flex justify-center px-7 py-4 border border-slate-300 text-navy font-semibold rounded-full hover:border-navy transition-colors'>{u.ctaWhatsapp}</a>
          </div>
        </div>

        <div class='rounded-3xl border border-slate-200 bg-white p-3 shadow-xl shadow-navy/5'>
          <div class='rounded-2xl bg-surface p-5 sm:p-6'>
            <div class='flex items-center justify-between'>
              <p class='font-bold text-navy'>{u.servicesTitle}</p>
              <span class='flex h-10 w-10 items-center justify-center rounded-xl bg-accent text-primary-dark'><IndustryIcon id={current.id} class='h-5 w-5' /></span>
            </div>
            <p class='mt-1 text-xs text-slate'>{u.servicesToday}</p>
            <ul class='mt-5 space-y-2.5'>
              {
                agenda.map((slot) => (
                  <li class='flex items-center gap-3 text-sm'>
                    <span class='tabular w-12 shrink-0 text-slate'>{slot.time}</span>
                    <span class='flex flex-1 items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3'>
                      <span class='font-medium text-ink'>{slot.name}</span>
                      <span class='tabular shrink-0 text-xs text-slate'>{slot.duration}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class='mt-4 text-xs text-slate'>{u.servicesCaption}</p>
          </div>
        </div>
      </div>
    </section>

    <section class='py-16 sm:py-20 bg-white'>
      <div class='max-w-6xl mx-auto px-6'>
        <h2 class='text-3xl font-bold text-navy tracking-tight'>{u.painsTitle}</h2>
        <div class='mt-10 grid gap-6 md:grid-cols-3'>
          {
            copy.pains.map((pain) => (
              <article class='reveal rounded-2xl border border-danger/15 bg-danger-surface/60 p-6'>
                <h3 class='font-bold text-navy'>{pain.title}</h3>
                <p class='mt-2 text-slate leading-relaxed'>{pain.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class='py-16 sm:py-20'>
      <div class='max-w-6xl mx-auto px-6'>
        <h2 class='text-3xl font-bold text-navy tracking-tight'>{u.benefitsTitle}</h2>
        <div class='mt-10 grid gap-6 md:grid-cols-3'>
          {
            copy.benefits.map((benefit) => (
              <article class='reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-sm'>
                <span class='flex h-9 w-9 items-center justify-center rounded-full bg-accent text-primary-dark'>
                  <svg class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                    <path d='M5 13l4 4L19 7' />
                  </svg>
                </span>
                <h3 class='mt-4 font-bold text-navy'>{benefit.title}</h3>
                <p class='mt-2 text-slate leading-relaxed'>{benefit.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class='py-16 sm:py-20 bg-white'>
      <div class='max-w-3xl mx-auto px-6'>
        <h2 class='text-3xl font-bold text-navy tracking-tight text-center'>{u.faqTitle}</h2>
        <div class='mt-10 grid gap-4'>
          {
            copy.faqs.map((faq) => (
              <div class='rounded-xl border border-slate-200 bg-surface p-6'>
                <h3 class='font-bold text-navy'>{faq.q}</h3>
                <p class='mt-2 text-sm text-slate leading-relaxed'>{faq.a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class='py-16 sm:py-20'>
      <div class='max-w-6xl mx-auto px-6'>
        <div class='rounded-3xl bg-navy px-6 py-12 sm:px-12 text-center text-white'>
          <h2 class='text-3xl font-bold tracking-tight'>{u.ctaTitle}</h2>
          <p class='mt-3 text-slate-300 max-w-xl mx-auto'>{u.ctaDesc}</p>
          <a href={contactHref} class='press mt-8 inline-flex px-8 py-4 bg-primary-dark text-white font-semibold rounded-full hover:bg-primary transition-colors'>{u.ctaButton}</a>
        </div>

        {
          others.length > 0 && (
            <div class='mt-16'>
              <h2 class='text-xl font-bold text-navy'>{u.otherTitle}</h2>
              <ul class='mt-6 flex flex-wrap gap-2'>
                {others.map((other) => (
                  <li>
                    <a href={industryPath(country, other.id)} class='inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-ink hover:border-primary hover:text-primary-dark transition-colors'>
                      <IndustryIcon id={other.id} class='h-4 w-4 text-primary-dark' />
                      {other.copy.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer country={country} />
</Layout>
