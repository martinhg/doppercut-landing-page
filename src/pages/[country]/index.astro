---
export const prerender = true;

// Components
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import PricingMath from '../../components/PricingMath.astro';
import ProblemCards from '../../components/ProblemCards.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import StepConfigure from '../../components/steps/StepConfigure.astro';
import StepShare from '../../components/steps/StepShare.astro';
import StepBookings from '../../components/steps/StepBookings.astro';
import { stepDemos } from '../../i18n/stepDemos';
import { htmlLangFor } from '../../i18n/locale';
import type { CountryCode } from '../../i18n/locale';
import { Image } from 'astro:assets';
import { site, whatsappLink } from '../../config/site';
import { chrome } from '../../i18n/chrome';

// i18n
import { countries, countryTerms } from '../../i18n/config';
import { ui } from '../../i18n/content';

// Images
import dashboardImg from '../../assets/dashboard.webp';
import mobileImg from '../../assets/mobile.webp';
import websiteImg from '../../assets/website.webp';

export function getStaticPaths() {
  return Object.keys(countries).map((code) => ({ params: { country: code } }));
}

const countryParam = typeof Astro.params?.country === 'string' ? Astro.params.country : 'ar';
const currentCountry = countries[countryParam as keyof typeof countries] ?? countries.ar;
const lang = (currentCountry.lang ?? 'es_ar') as keyof typeof ui;
const t = ui[lang];
const terms = countryTerms[countryParam as keyof typeof countryTerms];

const tr = (text: string) => text.replace(/{appointment}/g, terms.appointment);

const c = chrome[lang];
const demo = stepDemos[lang];
const titleSEO = `${c.seo_short} | ${site.name} ${currentCountry.name}`;

const steps = [
  {
    step: '01',
    title: t.section_6.step1_title,
    text: t.section_6.step1_desc,
  },
  {
    step: '02',
    title: t.section_6.step2_title,
    text: t.section_6.step2_desc,
  },
  {
    step: '03',
    title: t.section_6.step3_title,
    text: t.section_6.step3_desc,
  },
];

const link = (path: string) => {
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${countryParam}${cleanPath}`;
};
---

<Layout title={titleSEO} description={t.layout.description} lang={lang}>
  <Navbar country={countryParam} />

  <main id='main'>
    <!-- 1. HERO SECTION -->
    <section class='relative pt-28 pb-16 sm:pt-32 sm:pb-20 lg:pt-44 lg:pb-32 overflow-hidden bg-surface'>
      <!-- === FONDO INTERACTIVO (Solo Desktop) === -->
      <div class='hidden xl:block absolute inset-0 w-full h-full pointer-events-none z-0' aria-hidden='true'>
        <!-- ELEMENTO 1: Notificación de Turno (Arriba Izquierda) -->
        <div class='absolute top-[10%] left-[5%] animate-float-slow bg-white p-4 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 flex items-center gap-3 w-64'>
          <div class='w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600'>
            <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M5 13l4 4L19 7'></path></svg>
          </div>
          <div>
            <div class='text-xs text-slate font-medium'>{tr(t.hero.elements.element_one.title)}</div>
            <div class='text-sm font-bold text-navy'>{t.hero.elements.element_one.subtitle}</div>
          </div>
        </div>

        <!-- ELEMENTO 2: Tarjeta de Ingresos (Arriba Derecha) -->
        <div class='absolute top-[10%] right-[5%] animate-float-medium delay-200 bg-white p-4 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 w-56'>
          <div class='flex justify-between items-center mb-2'>
            <span class='text-xs text-slate'>{t.hero.elements.element_two}</span>
            <span class='text-xs font-bold text-green-500 bg-green-50 px-2 py-0.5 rounded-full'>+12%</span>
          </div>
          <div class='text-2xl font-bold text-navy'>$45.800</div>
          <div class='h-1 w-full bg-slate-100 rounded-full mt-2 overflow-hidden'>
            <div class='h-full bg-primary w-[70%] rounded-full'></div>
          </div>
        </div>

        <!-- ELEMENTO 3: Perfil de Cliente (Abajo Izquierda) -->
        <div class='absolute top-[35%] left-[5%] animate-float-fast delay-100 bg-white/80 backdrop-blur-sm p-3 rounded-xl shadow-lg border border-white/50 flex items-center gap-3'>
          <div class='w-8 h-8 rounded-full bg-primary-gradient'></div>
          <div class='text-sm font-medium text-navy'>{t.hero.elements.element_three} 🔥</div>
        </div>

        <!-- ELEMENTO 4: Icono 3D/Shape Abstracto (Abajo Derecha) -->
        <div class='absolute top-[40%] right-[15%] animate-float-x-slow'>
          <!-- Círculo decorativo con gradiente -->
          <div class='w-24 h-24 rounded-full bg-linear-to-tr from-accent to-white opacity-60 blur-xl'></div>
          <div class='absolute inset-0 flex items-center justify-center'>
            <div class='w-16 h-16 bg-navy rounded-2xl flex items-center justify-center shadow-2xl text-white transform rotate-12'>
              <svg class='w-8 h-8' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>
            </div>
          </div>
        </div>

        <!-- ELEMENTO 5: Blur Turquesa gigante de fondo (Para dar atmósfera) -->
        <div class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 rounded-full blur-3xl -z-10'></div>
      </div>

      <!-- === CONTENIDO CENTRAL === -->
      <div class='max-w-6xl mx-auto px-6 text-center relative z-10'>
        <h1 class='text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-navy mb-6 leading-[1.05]'>
          {t.hero.title}{' '}
          <br class='hidden lg:block' />
          <span class='text-primary-dark'>{t.hero.subhero}</span>
        </h1>

        <p class='text-lg lg:text-xl text-slate max-w-2xl mx-auto mb-10'>{tr(t.hero.subtitle)}</p>

        <div class='flex flex-col sm:flex-row gap-3 sm:gap-6 justify-center items-center'>
          <a href='#contacto' class='press w-full sm:w-auto px-8 py-4 bg-primary-dark text-white rounded-full font-semibold shadow-[0_10px_30px_-10px_rgb(0_168_232/0.6)] hover:bg-navy transition-colors'>{t.section_8.form_btn}</a>
          <a href='#como-funciona' class='px-2 py-3 text-navy font-medium underline decoration-slate-300 underline-offset-4 hover:decoration-primary-dark transition-colors'>{t.nav.how}</a>
        </div>

        <ul class='mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate'>
          {
            [t.section_7.card_credit, t.section_7.card_caption, t.section_7.support].map((item) => (
              <li class='flex items-center gap-2'>
                <svg class='w-4 h-4 text-primary-dark' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.5' aria-hidden='true'><path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7' /></svg>
                {item}
              </li>
            ))
          }
        </ul>

        <!-- MOCKUP PRINCIPAL (Ancla visual) -->
        <div class='mt-14 sm:mt-16 relative'>
          <div class='absolute inset-0 bg-primary/15 blur-[80px] rounded-full scale-75' aria-hidden='true'></div>
          <Image
            src={dashboardImg}
            class='relative rounded-xl shadow-2xl shadow-navy/15 border border-slate-200/60 max-w-4xl mx-auto w-full h-auto'
            alt={`${site.name}: ${t.section_5.c1_title}`}
            widths={[480, 768, 1024, 1536]}
            sizes='(max-width: 896px) 100vw, 896px'
            loading='eager'
            fetchpriority='high'
            format='webp'
            quality={80}
          />
        </div>
      </div>
    </section>

    <!-- 2. PROBLEMA / AGITACIÓN (Bento Grid Style) -->
    <section class='py-24 bg-white relative overflow-hidden'>

      <div class='max-w-6xl mx-auto px-6 relative z-10'>
        <div class='text-center max-w-3xl mx-auto mb-12 lg:mb-14 reveal'>
          <h2 class='text-3xl lg:text-4xl font-bold text-navy mb-6'>{t.problems.title}<br /><span class='text-primary'>{t.problems.subtitle}</span></h2>
          <p class='text-slate text-lg leading-relaxed'>{t.problems.description}</p>
        </div>

        <ProblemCards copy={t.problems} />

        <!-- Conector Visual (Flecha hacia abajo) -->
        <div class='mt-20 flex justify-center'>
          <div class='flex flex-col items-center gap-3'>
            <span class='text-base font-semibold text-primary-dark'>{t.problems.connector}</span>
            <div class='w-px h-15 bg-linear-to-b from-slate-200 to-primary'></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. BENEFICIOS (Grid 3 Cols - Final Polish) -->
    <section class='py-20 lg:py-24 bg-slate-50/50 relative'>
      <div class='max-w-6xl mx-auto px-6 relative z-10'>
        <div class='text-center max-w-3xl mx-auto mb-12 lg:mb-14 reveal'>
          <h2 class='text-3xl lg:text-4xl font-bold text-navy mb-4 tracking-tight'>{t.features.title}</h2>
          <p class='text-slate text-lg leading-relaxed'>{t.features.subtitle}</p>
        </div>

        <FeatureCards copy={t.features} demo={demo} locale={htmlLangFor(countryParam as CountryCode)} countryCode={countryParam} />
      </div>
    </section>

    <!-- 4. MÉTRICAS SOCIALES & LOGOS -->
    <section class='py-16 bg-navy overflow-hidden text-white relative'>
      <!-- Fondo decorativo sutil -->
      <div class='absolute top-0 left-0 w-full h-full overflow-hidden z-0 opacity-20'>
        <div class='absolute top-[-10%] left-[-10%] w-96 h-96 bg-primary rounded-full blur-[100px]'></div>
        <div class='absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-primary-dark rounded-full blur-[100px]'></div>
      </div>
      <div class='max-w-6xl mx-auto px-6 relative z-10'>
        <div class='grid grid-cols-1 sm:grid-cols-3 gap-10 text-center'>
          {
            [
              { value: 10, label: t.metrics.active_business, prefix: '+', suffix: '' },
              { value: 1000, label: t.metrics.appointments, prefix: '+', suffix: '' },
              { value: 15, label: t.metrics.professionals, prefix: '+', suffix: '' },
            ].map((metric) => (
              <div class='reveal'>
                <div class='tabular text-4xl lg:text-5xl font-bold text-primary-light mb-2 flex justify-center items-baseline'>
                  <span>{metric.prefix}</span>
                  <span class='counter-animate' data-target={metric.value}>{metric.value.toLocaleString(currentCountry.lang === 'en' ? 'en-US' : 'es-AR')}</span>
                  <span>{metric.suffix}</span>
                </div>
                <div class='text-slate-300 font-medium'>{metric.label}</div>
              </div>
            ))
          }
        </div>
              </div>

    </section>

    <!-- 5. FEATURES (Bento Grid Style - High Fidelity) -->
    <section class='py-20 lg:py-32 bg-white relative overflow-hidden'>
      <div class='max-w-7xl mx-auto px-6 relative z-10'>
        <div class='max-w-3xl mx-auto text-center mb-12 lg:mb-16'>
          <h2 class='text-3xl font-bold tracking-tight text-navy sm:text-5xl mb-6 text-balance'>
            {t.section_5.title.split(/(?<=\.)\s+/).map((sentence) => <span class='block'>{sentence}</span>)}
          </h2>
          <p class='text-lg leading-relaxed text-slate'>{t.section_5.subtitle}</p>
        </div>

        <div class='grid lg:grid-cols-3 gap-6'>
          <!-- Card Grande: Panel Administrativo -->
          <div data-tilt-target class='reveal lg:col-span-2 bg-surface rounded-[2rem] p-8 lg:p-12 pb-0 lg:pb-0 border border-slate-200 overflow-hidden relative group flex flex-col min-h-[28rem] lg:min-h-[34rem]'>
            <!-- Texto -->
            <div class='relative z-10 max-w-md mb-8'>
              <h3 class='text-2xl font-bold text-navy mb-4'>{t.section_5.c1_title}</h3>
              <p class='text-slate leading-relaxed'>{tr(t.section_5.c1_desc)}</p>
            </div>
            <!-- Screenshot in a browser frame; tilts flat on scroll -->
            <div class='relative mt-auto -mr-8 lg:-mr-12 ml-4 lg:ml-24 h-56 sm:h-72 lg:h-80 [perspective:1400px]'>
              <div data-tilt='dashboard' class='w-full h-full origin-bottom bg-white rounded-tl-xl shadow-2xl border border-slate-200/60 overflow-hidden'>
                <!-- Barra superior del navegador simulada -->
                <div class='h-8 bg-slate-50 border-b border-slate-100 flex items-center gap-2 px-4'>
                  <div class='w-2.5 h-2.5 rounded-full bg-red-400/50'></div>
                  <div class='w-2.5 h-2.5 rounded-full bg-amber-400/50'></div>
                  <div class='w-2.5 h-2.5 rounded-full bg-green-400/50'></div>
                </div>

                <Image src={websiteImg} loading='lazy' alt={`${site.name}: ${t.section_5.c1_title}`} widths={[640, 1024, 1600]} sizes='(max-width: 1024px) 100vw, 800px' format='webp' quality={80} class='w-full h-full object-cover object-left-top' />
              </div>
            </div>
          </div>

          <!-- Card Pequeña: Mobile First -->
          <div data-tilt-target class='reveal delay-100 lg:col-span-1 bg-navy rounded-[2rem] p-8 pb-0 relative overflow-hidden text-white flex flex-col'>
            <div class='absolute top-0 right-0 w-64 h-64 bg-primary rounded-full blur-[120px] opacity-20' aria-hidden='true'></div>
            <div class='relative z-10 mb-8'>
              <h3 class='text-xl font-bold mb-3'>{t.section_5.c2_title}</h3>
              <p class='text-slate-300 text-sm leading-relaxed'>{t.section_5.c2_desc}</p>
            </div>
            <!-- Phone screenshot; rises on scroll -->
            <div class='mt-auto flex justify-center relative [perspective:1200px]'>
              <div data-tilt='phone' class='origin-bottom relative w-[220px] h-[400px] bg-white rounded-t-[2.5rem] border-8 border-b-0 border-slate-800 shadow-2xl ring-1 ring-white/10 overflow-hidden'>
                <!-- Notch / Isla Dinámica -->
                <div class='absolute top-0 left-1/2 -translate-x-1/2 h-7 w-24 bg-black rounded-b-2xl z-20 flex items-center justify-center gap-2'>
                  <div class='w-12 h-1.5 bg-slate-800/50 rounded-full'></div>
                </div>

                <Image src={mobileImg} alt={`${site.name}: ${t.section_5.c2_title}`} loading='lazy' widths={[220, 440]} sizes='220px' format='webp' quality={80} class='w-full h-full object-cover object-top bg-white pt-4' />
                <!-- Brillo sobre la pantalla (Glass Reflection) -->
                <div class='absolute inset-0 bg-linear-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-10'></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CÓMO FUNCIONA (Timeline Service) -->
    <section id='como-funciona' class='py-24 bg-slate-50 relative overflow-hidden'>
      <div class='max-w-5xl mx-auto px-6 relative z-10'>
        <!-- Título -->
        <div class='text-center max-w-3xl mx-auto mb-20 reveal'>
          <h2 class='text-3xl lg:text-4xl font-bold text-navy mb-4'>{t.section_6.title}</h2>
          <p class='text-slate text-lg'>{t.section_6.subtitle}</p>
        </div>

        <div class='relative'>
          <!-- Línea vertical central (Solo desktop) -->
          <div class='absolute left-8 lg:left-1/2 top-0 bottom-0 w-0.5 bg-slate-200 -translate-x-1/2 hidden lg:block'></div>
          {
            steps.map((item, i) => (
              <div class={`reveal relative flex flex-col lg:flex-row gap-6 lg:gap-8 mb-14 lg:mb-24 ${i % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
                <div class='flex-1 lg:text-right'>
                  <div class={`hidden lg:block ${i % 2 !== 0 ? 'lg:text-left' : ''}`}>
                    <h3 class='text-2xl font-bold text-navy mb-3'>{item.title}</h3>
                    <p class='text-slate text-lg leading-relaxed'>{item.text}</p>
                  </div>
                </div>
                <div class='relative shrink-0 hidden lg:flex justify-center z-10'>
                  <div class='w-16 h-16 rounded-full bg-white shadow-lg flex items-center justify-center relative'>
                    <div class='absolute inset-0 rounded-full p-[3px] bg-primary-gradient -z-10' />
                    <div class='w-full h-full bg-white rounded-full flex items-center justify-center'>
                      <span class='tabular text-xl font-bold text-primary-dark'>{item.step}</span>
                    </div>
                  </div>
                </div>

                <div class='flex-1'>
                  <div class='lg:hidden mb-6'>
                    <h3 class='text-xl font-bold text-navy'>{item.title}</h3>
                    <p class='text-slate mt-2'>{item.text}</p>
                  </div>
                  <div class='bg-white rounded-2xl border border-slate-200 shadow-lg shadow-navy/5 overflow-hidden relative h-56 md:h-64' aria-hidden='true'>
                    {i === 0 && <StepConfigure demo={demo} />}
                    {i === 1 && <StepShare demo={demo} />}
                    {i === 2 && <StepBookings demo={demo} />}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7. PRICING TEASER (Clean Style) -->
    <section class='py-24 bg-white relative'>
      <div class='max-w-4xl mx-auto px-6'>
        <div class='text-center max-w-2xl mx-auto mb-12'>
          <h2 class='reveal text-3xl md:text-4xl font-bold text-navy mb-4 tracking-tight'>{t.section_7.title}</h2>
          <p class='text-slate text-lg'>{t.section_7.subtitle}</p>
        </div>

        <PricingMath
          copy={t.section_7}
          planName={t.pricing.card_title}
          monthLabel={t.pricing.month}
          priceRegular={currentCountry.price_regular}
          pricePromo={currentCountry.price_promo}
          currency={currentCountry.currency}
          countryCode={countryParam}
          locale={htmlLangFor(countryParam as CountryCode)}
          pricingHref={link('/precios')}
        />
      </div>
    </section>

    <!-- 8. FINAL CTA & CONTACT (Navy Section) -->
    <section id='contacto' class='py-24 bg-navy relative overflow-hidden'>
      <!-- Círculo de luz muy sutil en una esquina -->
      <div class='absolute top-0 right-0 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[100px] pointer-events-none' aria-hidden='true'></div>

      <div class='max-w-6xl mx-auto px-6 relative z-10 grid lg:grid-cols-2 gap-16 items-start pt-8'>
        <!-- COLUMNA IZQUIERDA: Mensaje + WhatsApp Directo -->
        <div class='reveal text-white flex flex-col h-full justify-center'>
          <h2 class='text-4xl lg:text-5xl font-bold mb-6 leading-tight tracking-tight'>
            {t.section_8.title1}
            <br />{t.section_8.title2}
          </h2>
          <p class='text-slate-300 text-lg mb-10 leading-relaxed'>{t.section_8.subtitle}</p>

          <!-- Opción A: WhatsApp Card -->
          <div class='bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group'>
            <a href={whatsappLink(c.whatsapp_message)} target='_blank' rel='noopener noreferrer' class='flex items-center gap-5'>
              <div class='w-14 h-14 shrink-0 bg-[#25D366] rounded-full flex items-center justify-center'>
                <svg class='w-8 h-8 text-ink' fill='currentColor' viewBox='0 0 24 24' aria-hidden='true'
                  ><path
                    d='M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z'
                  ></path></svg
                >
              </div>
              <div>
                <h3 class='text-white font-bold text-lg group-hover:text-primary-light transition-colors'>{t.section_8.ws_title}</h3>
                <p class='text-slate-300 text-sm'>{t.section_8.ws_desc}</p>
              </div>
              <div class='ml-auto text-slate group-hover:translate-x-1 transition-transform'>
                <svg class='w-5 h-5' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7'></path></svg>
              </div>
            </a>
          </div>

          <!-- Datos de contacto extra (Opcional) -->
          <div class='mt-8 flex flex-wrap items-center gap-6 text-slate-300 text-sm'>
            <a href={`mailto:${site.email}`} class='flex items-center gap-2 hover:text-white transition-colors'>
              <svg class='w-4 h-4' fill='none' viewBox='0 0 24 24' stroke='currentColor' aria-hidden='true'
                ><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'></path></svg
              >
              {site.email}
            </a>
          </div>
        </div>

        <!-- COLUMNA DERECHA: Opción B - Formulario Formal -->
        <div class='reveal delay-200 bg-white rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/20'>
          <h3 class='text-navy font-bold text-2xl mb-2'>{t.section_8.form_title}</h3>
          <p class='text-slate text-sm mb-6'>{t.section_8.form_desc}</p>

          <LeadForm lang={lang} country={countryParam} source='home' />
        </div>
      </div>
    </section>
