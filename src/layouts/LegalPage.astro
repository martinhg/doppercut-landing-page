---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  updated: string;
  summary?: string;
}

const { title, description, updated, summary } = Astro.props;
const country = String(Astro.params.country ?? 'ar');
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: new URL(`/${country}`, site.url).href },
    { '@type': 'ListItem', position: 2, name: title },
  ],
};
---

<Layout title={title} description={description} schema={[breadcrumb]}>
  <Navbar />
  <main id='main' class='pt-28 sm:pt-32 pb-20 bg-surface min-h-svh'>
    <article class='max-w-3xl mx-auto px-4 sm:px-6'>
      <div class='bg-white rounded-3xl p-6 sm:p-10 md:p-12 border border-slate-200'>
        <h1 class='text-3xl sm:text-4xl font-bold text-navy tracking-tight'>{title}</h1>
        <p class='mt-2 text-sm text-slate'>Última actualización: {updated}</p>

        {
          summary && (
            <div class='mt-8 rounded-2xl bg-accent p-5 text-primary-dark'>
              <p class='text-sm leading-relaxed'>{summary}</p>
            </div>
          )
        }

        <div class='legal mt-8'>
          <slot />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal {
    color: var(--color-slate);
    line-height: 1.7;
    max-width: 70ch;
  }
  .legal h2 {
    color: var(--color-navy);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
  }
  .legal h2:first-child {
    margin-top: 0;
  }
  .legal p + p,
  .legal ul,
  .legal table {
    margin-top: 0.75rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal li + li {
    margin-top: 0.375rem;
  }
  .legal strong {
    color: var(--color-ink);
  }
  .legal a {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }
  .legal table {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
  }
  .legal th,
  .legal td {
    text-align: left;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
  }
  .legal th {
    color: var(--color-navy);
    font-weight: 600;
  }
</style>
