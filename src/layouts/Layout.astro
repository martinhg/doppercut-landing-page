---
import '../styles/global.css';

import { countries } from '../i18n/config';
import { chrome } from '../i18n/chrome';
import { htmlLangFor, resolveLocale } from '../i18n/locale';
import { site, whatsappLink } from '../config/site';
import CookieNotice from '../components/CookieNotice.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  country?: string;
  /** Extra JSON-LD nodes for this page (FAQ, breadcrumbs...). */
  schema?: Record<string, unknown>[];
}

const { title, description, image = site.ogImage, noindex = false, schema = [] } = Astro.props;
const locale = resolveLocale(Astro.props.country ?? Astro.params.country);
const c = chrome[locale.lang];

const pageTitle = !title ? `${site.name} | ${c.seo_title}` : title.includes(site.name) ? title : `${title} | ${site.name}`;
const pageDescription = description ?? c.seo_description;

const siteUrl = Astro.site ?? new URL(site.url);
const canonicalURL = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteUrl);
const socialImageURL = new URL(image, siteUrl);
const pathWithoutCountry = Astro.url.pathname.replace(new RegExp(`^/${locale.code}(?=/|$)`), '').replace(/\/$/, '');

const numericPrice = locale.country.price_promo.replace(/[^0-9.,]+/g, '').replace(/\.(?=\d{3})/g, '').replace(',', '.');

const graph = [
  {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: new URL(site.logo.raster, siteUrl).href,
    email: site.email,
    sameAs: [site.instagram],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: site.email,
      telephone: `+${site.whatsappNumber}`,
      availableLanguage: ['es', 'pt', 'en'],
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    inLanguage: locale.htmlLang,
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'SoftwareApplication',
    name: site.name,
    url: canonicalURL.href,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: pageDescription,
    publisher: { '@id': `${site.url}/#organization` },
    ...(locale.country.currency && Number(numericPrice)
      ? {
          offers: {
            '@type': 'Offer',
            price: numericPrice,
            priceCurrency: locale.country.currency,
            availability: 'https://schema.org/InStock',
          },
        }
      : {}),
  },
  ...schema,
];
---

<!doctype html>
<html lang={locale.htmlLang} class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover' />
    <script is:inline>
      // Opt into scroll reveal. If the reveal script never runs (blocked or failed),
      // show everything after a short delay so content can never stay hidden.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (window.__revealReady) return;
        document.querySelectorAll('.reveal').forEach(function (el) {
          el.classList.add('in-view');
        });
      }, 2500);
    </script>

    <title>{pageTitle}</title>
    <meta name='description' content={pageDescription} />
    <link rel='canonical' href={canonicalURL} />
    <meta name='robots' content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {site.googleSiteVerification && <meta name='google-site-verification' content={site.googleSiteVerification} />}

    {
      !noindex &&
        Object.values(countries).map((country) => (
          <link rel='alternate' hreflang={htmlLangFor(country.code as keyof typeof countries)} href={new URL(`/${country.code}${pathWithoutCountry}`, siteUrl)} />
        ))
    }
    {!noindex && <link rel='alternate' hreflang='x-default' href={new URL(`/us${pathWithoutCountry}`, siteUrl)} />}

    <link rel='icon' href='/brand/favicon.ico' sizes='any' />
    <link rel='icon' href='/brand/favicon.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/brand/icon-180.png' />
    <link rel='manifest' href='/site.webmanifest' />
    <meta name='theme-color' content={site.themeColor} />
    <meta name='author' content={site.name} />

    <meta property='og:site_name' content={site.name} />
    <meta property='og:type' content='website' />
    <meta property='og:locale' content={locale.ogLocale} />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={pageDescription} />
    <meta property='og:image' content={socialImageURL} />
    <meta property='og:image:type' content='image/jpeg' />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={`${site.name}: ${site.tagline}`} />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={pageTitle} />
    <meta name='twitter:description' content={pageDescription} />
    <meta name='twitter:image' content={socialImageURL} />

    <script type='application/ld+json' set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body class='bg-white text-ink font-sans antialiased overflow-x-hidden'>
    <a href='#main' class='sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-navy focus:text-white'>{c.skip}</a>

    <slot />

    <a
      href={whatsappLink(c.whatsapp_message)}
      target='_blank'
      rel='noopener noreferrer'
      class='press fixed right-4 sm:right-6 z-40 flex items-center gap-2 rounded-full bg-[#25D366] text-ink shadow-lg shadow-black/15 pl-4 pr-4 sm:pr-5 py-3.5 font-semibold text-sm'
      style='bottom: max(1rem, env(safe-area-inset-bottom));'
      aria-label={c.whatsapp_label}
      data-whatsapp-fab
    >
      <svg class='w-6 h-6 shrink-0' fill='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
        <path
          d='M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z'
        ></path>
      </svg>
      <span class='hidden sm:inline'>WhatsApp</span>
    </a>

    <CookieNotice lang={locale.lang} country={locale.code} />

    <div hidden data-form-messages={JSON.stringify({ sending: c.form_sending, success: c.form_success, error: c.form_error, tooFast: c.form_too_fast, required: c.form_required })}></div>

    <script>
      // Scroll reveal. Content is visible without JS; the `js` class opts into the effect.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealTargets = document.querySelectorAll('.reveal');
      (window as Window & { __revealReady?: boolean }).__revealReady = true;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealTargets.forEach((el) => el.classList.add('in-view'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('in-view');
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        revealTargets.forEach((el) => revealObserver.observe(el));
      }

      // Counters: the final number is in the markup; the count-up is progressive enhancement.
      const counters = document.querySelectorAll<HTMLElement>('.counter-animate');
      const locale = document.documentElement.lang;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const counter = entry.target as HTMLElement;
              counterObserver.unobserve(counter);
              const target = Number(counter.dataset.target ?? 0);
              const duration = 1600;
              let start: number | null = null;
              const tick = (now: number) => {
                start ??= now;
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 4);
                counter.textContent = Math.floor(eased * target).toLocaleString(locale);
                if (progress < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach((counter) => counterObserver.observe(counter));
      }

      // Lead forms (Web3Forms). Spam protection: honeypot, minimum fill time and native validation.
      const messagesEl = document.querySelector<HTMLElement>('[data-form-messages]');
      const messages = JSON.parse(messagesEl?.dataset.formMessages ?? '{}');
      const MIN_FILL_MS = 3000;

      document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
        const renderedAt = Date.now();
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const label = button?.querySelector('span');
        const idleLabel = label?.textContent ?? '';
        const status = form.querySelector<HTMLElement>('[data-form-status]');

        const show = (text: string, tone: 'success' | 'error') => {
          if (!status) return;
          status.textContent = text;
          status.dataset.tone = tone;
          status.hidden = false;
        };

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!form.checkValidity()) {
            form.reportValidity();
            show(messages.required, 'error');
            return;
          }

          const data = new FormData(form);
          // Bots fill hidden fields and submit instantly; drop both silently or ask to retry.
          if (data.get('botcheck') || data.get('website')) return;
          if (Date.now() - renderedAt < MIN_FILL_MS) {
            show(messages.tooFast, 'error');
            return;
          }
          data.delete('website');

          if (status) status.hidden = true;
          if (button) {
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');
          }
          if (label) label.textContent = messages.sending;

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(Object.fromEntries(data)),
            });
            const json = await response.json().catch(() => ({}));
            if (response.ok && json.success !== false) {
              show(messages.success, 'success');
              form.reset();
              (window as unknown as { va?: (...args: unknown[]) => void }).va?.('event', { name: 'lead_submitted', data: { form: form.dataset.leadForm ?? 'unknown' } });
            } else {
              show(messages.error, 'error');
            }
          } catch {
            show(messages.error, 'error');
          } finally {
            if (button) {
              button.disabled = false;
              button.removeAttribute('aria-busy');
            }
            if (label) label.textContent = idleLabel;
          }
        });
      });
    </script>
  </body>
</html>
